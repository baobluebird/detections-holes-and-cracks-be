<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Forgot Password</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-md">
    <h2 class="text-2xl font-bold mb-6 text-center text-gray-800">Forgot Password</h2>

    <div id="message" class="hidden mb-4 p-3 rounded text-sm"></div>

    <form id="forgotForm" class="space-y-4">
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email address</label>
        <input type="email" id="email" name="email" required
          class="mt-1 w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-blue-500"
          placeholder="you@gmail.com" />
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">Send
        Code</button>
    </form>
  </div>

  <script>
    const messageBox = document.getElementById('message');
    function showMessage(message, type = 'success', duration = 3000) {
      messageBox.classList.remove('hidden');
      messageBox.textContent = message;

      if (type === 'success') {
        messageBox.className = 'bg-green-100 text-green-700 p-2 rounded mb-4';
      } else {
        messageBox.className = 'bg-red-100 text-red-700 p-2 rounded mb-4';
      }

      // Ẩn sau thời gian
      setTimeout(() => {
        messageBox.classList.add('hidden');
      }, duration);
    }
    document.getElementById('forgotForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;

      try {
        const res = await fetch('/api/code/create-code', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email })
        });

        const data = await res.json();

        if (data.status === 'OK') {
          console.log(data);
           showMessage(data.message, 'success', 2000);
          setTimeout(() => {
            window.location.href = `/home/verify-code/${data.id}`;
          }, 1500);
        } else {
           showMessage(data.message, 'error', 2000);
        }
      } catch (err) {
        showMessage('Error sending email', 'error', 2000);

      }
    });
  </script>
</body>

</html>