<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Data Send Help</title>
    <style>
        .back-end-server {
            width: auto;
        }

        * {
            margin: 0;
            padding: 0;
        }

        .topnav {
            background-color: #333;
            overflow: hidden;
        }

        .topnav a {
            float: left;
            color: #f2f2f2;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
            font-size: 17px;
        }

        .topnav a:hover {
            background-color: #ddd;
            color: black;
        }

        .topnav a.active {
            background-color: #04AA6D;
            color: white;
        }

        .form-add-new {
            width: 500px;
            margin: 0 auto;
            padding-top: 100px;
        }

        .input-group {
            padding: 10px;
        }

        button {
            margin: 10px;
            cursor: pointer;
        }

        .d-none {
            display: none;
        }

        .title {
            font-size: 25px;
            font-weight: 600;
            padding-bottom: 10px;
        }

        .table-container {
            padding: 15px 20px;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th,
        td {
            padding: 8px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }

        tr:hover {
            background-color: rgb(180, 178, 178);
        }

        .content,
        .topnav {
            display: none;
        }

        /* Thêm style cho error-message để đồng bộ với Home Data Send Help */
        .error-message {
            padding: 20px;
            background-color: #f44336;
            color: white;
            text-align: center;
            margin: 20px;
            border-radius: 5px;
            display: none;
        }

        .alert {
            padding: 20px;
            background-color: #f44336;
            color: white;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            text-align: center;
            z-index: 1000;
            display: none;
        }

        .closebtn {
            margin-left: 15px;
            color: white;
            font-weight: bold;
            float: right;
            font-size: 22px;
            line-height: 20px;
            cursor: pointer;
            transition: 0.3s;
        }

        .closebtn:hover {
            color: black;
        }

        .error-message {
            padding: 20px;
            background-color: #f44336;
            color: white;
            text-align: center;
            margin: 20px;
            border-radius: 5px;
            display: none;
        }
    </style>
</head>

<body>
    <div class="error-message" id="errorMessage"></div>
    <div class="topnav" style="display: none;">
        <a href="/home/map">Map</a>
        <a href="/home/data-hole">Holes Data</a>
        <a href="/home/data-crack">Cracks Data</a>
        <a href="/home/data-maintain">Maintain Road Data</a>
        <a href="/home/data-damage">Damage Road Data</a>
        <a class="active" href="/home/data-send-help">Home Data Send Help</a>
        <a href="/home/search">Search</a>
        <a href="/home/chart">Chart</a>
        <a href="/home/logout">Logout</a>
    </div>
    <div class="alert" id="alert">
        <span class="closebtn" onclick="this.parentElement.style.display='none';">×</span>
        New help request added!
    </div>
    <div class="error-message" id="errorMessage" style="display: none; color: red; padding: 10px; text-align: center;">
    </div>
    <div class="table-container" id="ListContainer" style="display: none;">
        <div class="title">List Data Send Rescue</div>
        <% var count=listData.length %>
            <div><strong>Total Send Rescue:</strong> <span id="dataCount">
                    <%= count %>
                </span></div>
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Id User</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th>Address</th>
                        <th>Time Send</th>
                        <th>Map</th>
                    </tr>
                </thead>
                <tbody>
                    <% listData.forEach(function(data, index){ %>
                        <tr>
                            <td>
                                <%= index + 1 %>
                            </td>
                            <td>
                                <%= data.user %>
                            </td>
                            <td>
                                <%= data.name %>
                            </td>
                            <td>
                                <%= data.phone %>
                            </td>
                            <td>
                                <%= data.location %>
                            </td>
                            <td>
                                <%= data.address %>
                            </td>
                            <td>
                                <%= new Date(data.createdAt).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' })
                                    %>
                            </td>
                            <td><button onclick="openMap('<%= data.location %>')">View on Map</button></td>
                        </tr>
                        <% }) %>
                </tbody>
            </table>
    </div>

    <script>
        console.log('Script loaded'); // Debug

        function openMap(location) {
            var url = 'https://www.google.com/maps?q=' + location;
            window.open(url, '_blank');
        }
        // Hàm kiểm tra token và quyền admin
        async function checkAdminAccess() {
            console.log('Checking admin access'); // Debug
            const token = localStorage.getItem('access_token') || sessionStorage.getItem('access_token');
            console.log('Token:', token); // Debug
            const errorMessageDiv = document.getElementById('errorMessage');
            const listContainer = document.getElementById('ListContainer');
            const topnav = document.querySelector('.topnav');

            if (!token) {
                errorMessageDiv.style.display = 'block';
                errorMessageDiv.textContent = 'Please log in to access this page.';
                setTimeout(() => {
                    window.location.href = '/home/login';
                }, 2000);
                return;
            }

            try {
                const response = await fetch('/api/user/send-token', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ token }),
                });

                const data = await response.json();
                console.log('Response from /send-token:', data); // Debug

                if (data.status === 'OK' && data.isAdmin) {
                    console.log('Admin access confirmed'); // Debug
                    listContainer.style.display = 'block';
                    topnav.style.display = 'block';
                } else {
                    errorMessageDiv.style.display = 'block';
                    errorMessageDiv.textContent ='You do not have permission to access this page.';
                    localStorage.removeItem('access_token');
                    sessionStorage.removeItem('access_token');
                    setTimeout(() => {
                        window.location.href = '/home/login';
                    }, 2000);
                }
            } catch (error) {
                console.error('Fetch error:', error);
                errorMessageDiv.style.display = 'block';
                errorMessageDiv.textContent = 'An error occurred. Please try again.';
                localStorage.removeItem('access_token');
                sessionStorage.removeItem('access_token');
                setTimeout(() => {
                    window.location.href = '/home/login';
                }, 2000);
            }
        }


        // Chạy kiểm tra ngay lập tức
        try {
            checkAdminAccess();
        } catch (error) {
            console.error('Error running checkAdminAccess:', error);
            document.getElementById('errorMessage').style.display = 'block';
            document.getElementById('errorMessage').textContent = 'An error occurred. Please try again.';
            setTimeout(() => {
                window.location.href = '/home/login';
            }, 2000);
        }
    </script>
</body>

</html>