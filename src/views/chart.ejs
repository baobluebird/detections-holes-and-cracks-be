<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Monthly Statistics</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .topnav,
        .content {
            display: none; /* Ẩn nội dung mặc định */
        }

        .topnav {
            background-color: #333;
            overflow: hidden;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
        }

        .topnav a {
            float: left;
            color: #f2f2f2;
            text-align: center;
            padding: 14px 16px;
            text-decoration: none;
            font-size: 17px;
        }

        .topnav a:hover {
            background-color: #ddd;
            color: black;
        }

        .topnav a.active {
            background-color: #04AA6D;
            color: white;
        }

        .content {
            padding-top: 60px;
            padding: 15px 20px;
        }

        .title {
            font-size: 25px;
            font-weight: 600;
            padding-bottom: 10px;
        }

        .chart-container {
            max-width: 1000px;
            margin: 20px auto;
        }

        #monthlyChart {
            max-height: 500px;
        }

        .filter-container {
            padding: 10px 20px;
        }

        .filter-container label {
            font-weight: bold;
            margin-right: 10px;
        }

        .filter-container select {
            padding: 5px;
            border-radius: 4px;
        }

        .notification {
            position: fixed;
            top: 70px;
            right: 20px;
            background-color: #333;
            color: white;
            padding: 10px 20px;
            border-radius: 4px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            z-index: 2000;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .notification.show {
            opacity: 1;
        }

        @media (max-width: 600px) {
            .content, .filter-container {
                padding: 10px;
            }

            .chart-container {
                max-width: 100%;
            }

            .notification {
                top: 60px;
                right: 10px;
                padding: 8px 15px;
                font-size: 14px;
            }
        }
    </style>
</head>

<body>
    <div id="errorMessage"></div>
    <div class="topnav">
        <a href="/home/map">Map</a>
        <a href="/home/data-hole">Holes Data</a>
        <a href="/home/data-crack">Cracks Data</a>
        <a href="/home/data-maintain">Maintain Road Data</a>
        <a href="/home/data-damage">Damage Road Data</a>
        <a href="/home/data-send-help">Home Data Send Help</a>
        <a href="/home/search">Search</a>
        <a class="active" href="/home/chart">Statistics</a>
        <a href="/home/logout">Logout</a>
    </div>

    <div class="content">
        <div class="title">Monthly Statistics</div>
        <div class="filter-container">
            <label for="yearSelect">Select Year:</label>
            <select id="yearSelect">
                <!-- Được điền động bằng JavaScript -->
            </select>
        </div>
        <div class="chart-container">
            <canvas id="monthlyChart"></canvas>
        </div>
    </div>

    <div id="notification-stats" class="notification"></div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            // Hàm hiển thị thông báo
            function showNotification(message) {
                const notification = document.getElementById('notification-stats');
                notification.textContent = message;
                notification.classList.add('show');
                setTimeout(() => {
                    notification.classList.remove('show');
                }, 3000);
            }

            // Hàm kiểm tra quyền admin
            async function checkAdminAccess() {
                const token = localStorage.getItem('access_token') || sessionStorage.getItem('access_token');
                const errorMessageDiv = document.getElementById('errorMessage');
                const content = document.querySelector('.content');
                const topnav = document.querySelector('.topnav');

                if (!token) {
                    errorMessageDiv.textContent = 'Please log in to access this page.';
                    errorMessageDiv.classList.add('show');
                    setTimeout(() => {
                        window.location.href = '/home/login';
                    }, 2000);
                    return false;
                }

                try {
                    const response = await fetch('/api/user/send-token', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ token }),
                    });

                    const data = await response.json();
                    if (response.ok && data.status === 'OK' && data.isAdmin) {
                        content.style.display = 'block';
                        topnav.style.display = 'block';
                        return true;
                    } else {
                        errorMessageDiv.textContent = data.message || 'You do not have permission to access this page.';
                        errorMessageDiv.classList.add('show');
                        localStorage.removeItem('access_token');
                        sessionStorage.removeItem('access_token');
                        setTimeout(() => {
                            window.location.href = '/home/login';
                        }, 2000);
                        return false;
                    }
                } catch (error) {
                    console.error('Fetch error:', error);
                    errorMessageDiv.textContent = 'An error occurred. Please try again.';
                    errorMessageDiv.classList.add('show');
                    localStorage.removeItem('access_token');
                    sessionStorage.removeItem('access_token');
                    setTimeout(() => {
                        window.location.href = '/home/login';
                    }, 2000);
                    return false;
                }
            }

            // Kiểm tra quyền admin
            const isAdmin = await checkAdminAccess();
            if (!isAdmin) return;

            // Điền danh sách năm vào dropdown
            const yearSelect = document.getElementById('yearSelect');
            const currentYear = new Date().getFullYear();
            for (let year = currentYear - 5; year <= currentYear; year++) {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                if (year === currentYear) option.selected = true;
                yearSelect.appendChild(option);
            }

            // Hàm vẽ biểu đồ
            let chartInstance = null;
            async function drawChart(year) {
                try {
                    const response = await fetch(`/api/detection/statistics/monthly?year=${year}`, {
                        headers: {
                            'Authorization': `Bearer ${localStorage.getItem('access_token') || sessionStorage.getItem('access_token')}`
                        }
                    });
                    const result = await response.json();
                    if (response.ok && result.status === 'OK') {
                        const labels = result.data.map(item => `Month ${item.month}`);
                        const cracksData = result.data.map(item => item.cracks);
                        const holesData = result.data.map(item => item.holes);
                        const roadsData = result.data.map(item => item.roads);
                        const damagesData = result.data.map(item => item.damages);

                        // Hủy biểu đồ cũ nếu tồn tại
                        if (chartInstance) {
                            chartInstance.destroy();
                        }

                        chartInstance = new Chart(document.getElementById('monthlyChart'), {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [
                                    {
                                        label: 'Cracks',
                                        data: cracksData,
                                        backgroundColor: 'rgba(255, 99, 132, 0.5)',
                                        borderColor: 'rgba(255, 99, 132, 1)',
                                        borderWidth: 1
                                    },
                                    {
                                        label: 'Holes',
                                        data: holesData,
                                        backgroundColor: 'rgba(54, 162, 235, 0.5)',
                                        borderColor: 'rgba(54, 162, 235, 1)',
                                        borderWidth: 1
                                    },
                                    {
                                        label: 'Roads',
                                        data: roadsData,
                                        backgroundColor: 'rgba(75, 192, 192, 0.5)',
                                        borderColor: 'rgba(75, 192, 192, 1)',
                                        borderWidth: 1
                                    },
                                    {
                                        label: 'Damages',
                                        data: damagesData,
                                        backgroundColor: 'rgba(255, 206, 86, 0.5)',
                                        borderColor: 'rgba(255, 206, 86, 1)',
                                        borderWidth: 1
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: true,
                                            text: 'Number of Items'
                                        }
                                    },
                                    x: {
                                        title: {
                                            display: true,
                                            text: 'Month'
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        position: 'top'
                                    },
                                    title: {
                                        display: true,
                                        text: `Monthly Statistics for ${year}`
                                    }
                                }
                            }
                        });
                        showNotification('Chart loaded successfully');
                    } else {
                        showNotification(result.message || 'Failed to load statistics');
                    }
                } catch (error) {
                    console.error('Error fetching statistics:', error);
                    showNotification('Error fetching statistics');
                }
            }

            // Vẽ biểu đồ lần đầu với năm hiện tại
            drawChart(currentYear);

            // Xử lý thay đổi năm
            yearSelect.addEventListener('change', function () {
                const selectedYear = this.value;
                drawChart(selectedYear);
            });
        });
    </script>
</body>

</html>